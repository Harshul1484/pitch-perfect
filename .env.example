# Firebase web config. These values ship to the browser and are not secrets —
# access is controlled by Firebase Security Rules and authorised domains, not
# by hiding them. They live here so the project can be pointed at a different
# Firebase project without editing code.
#
# Copy to .env.local and fill in from:
#   firebase apps:sdkconfig WEB <appId> --project <projectId>

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Sheet music import and printing. Unfinished, and off unless this is exactly
# the string "true" — anything else, including an empty value, leaves every
# sheet control unrendered. Changing it needs a redeploy, because Vite inlines
# the value when the bundle is built.
VITE_SHEET_MUSIC_ENABLED=false

# Where a scan is sent to be recognised. Left empty the import flow reports
# that recognition is unavailable rather than guessing a host. This service is
# a separate container; it is not part of the Vercel deployment.
VITE_OMR_API_URL=
